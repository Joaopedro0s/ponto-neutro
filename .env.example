# Conexão PostgreSQL (local, Neon ou Supabase).
# Local sem Docker: `npm run db:dev` sobe um PostgreSQL nestas portas.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Opcional: banco-sombra para `prisma migrate dev` (necessário com `prisma dev`; dispensável em produção).
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"
# Só para o banco local do `prisma dev`, que atende uma conexão por vez. Não use em produção.
DATABASE_POOL_MAX="1"
